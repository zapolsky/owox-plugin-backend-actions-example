{
  "name": "Weekly Sales Digest",
  "description": "Turns a sales Data Mart into a short weekly digest: revenue against the week before, the leading city, the biggest fall and the best day",
  "delivery": {
    "type": "remote",
    "url": "https://owox-plugin-backend-actions-example.e-zapolskiy.workers.dev/"
  },
  "credentials": [],
  "collections": [{ "name": "digests", "scope": "member" }],
  "backend": {
    "url": "/owox",
    "actions": {
      "write-digest": {
        "timeoutSeconds": 120,
        "input": {
          "type": "object",
          "required": ["dataMartId"],
          "properties": { "dataMartId": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      }
    }
  }
}
