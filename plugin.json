{
  "name": "Metric Watch",
  "description": "Watches a Data Mart metric by day, week, month or quarter, flags periods outside the usual range and explains which channels, campaigns or other values moved it",
  "delivery": {
    "type": "remote",
    "url": "https://owox-plugin-backend-actions-example.e-zapolskiy.workers.dev/"
  },
  "credentials": [
    {
      "id": "google-service-account",
      "optional": true,
      "scopes": ["https://www.googleapis.com/auth/documents", "https://www.googleapis.com/auth/spreadsheets"]
    }
  ],
  "collections": [
    { "name": "watches", "scope": "member" },
    { "name": "checks", "scope": "member" }
  ],
  "backend": {
    "url": "/owox",
    "actions": {
      "check-metric": {
        "timeoutSeconds": 180,
        "input": {
          "type": "object",
          "required": ["watchId"],
          "properties": {
            "watchId": { "type": "string", "minLength": 1, "maxLength": 100 },
            "periods": { "type": "integer", "minimum": 1, "maximum": 14 },
            "weeks": { "type": "integer", "minimum": 1, "maximum": 12 },
            "timeZone": { "type": "string", "minLength": 1, "maxLength": 64 },
            "documentId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "spreadsheetId": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "additionalProperties": false
        }
      },
      "export-check-to-doc": {
        "timeoutSeconds": 30,
        "input": {
          "type": "object",
          "required": ["checkId", "documentId"],
          "properties": {
            "checkId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "documentId": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "additionalProperties": false
        }
      },
      "export-check-to-sheet": {
        "timeoutSeconds": 30,
        "input": {
          "type": "object",
          "required": ["checkId", "spreadsheetId"],
          "properties": {
            "checkId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "spreadsheetId": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
