{
  "name": "Metric Watch",
  "description": "Watches a Data Mart metric week by week, flags weeks outside the usual range and explains which channels, campaigns or other values moved it",
  "delivery": {
    "type": "remote",
    "url": "https://owox-plugin-backend-actions-example.e-zapolskiy.workers.dev/"
  },
  "credentials": [],
  "collections": [
    { "name": "watches", "scope": "member" },
    { "name": "checks", "scope": "member" }
  ],
  "backend": {
    "url": "/owox",
    "actions": {
      "check-metric": {
        "timeoutSeconds": 180,
        "input": {
          "type": "object",
          "required": ["watchId"],
          "properties": {
            "watchId": { "type": "string", "minLength": 1, "maxLength": 100 },
            "weeks": { "type": "integer", "minimum": 1, "maximum": 12 }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
